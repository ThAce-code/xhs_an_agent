# Copy to .env and fill in real values.
GOOGLE_API_KEY=
TAVILY_API_KEY=

# Optional: Gemini proxy base URL (v1beta/models)
# Example:
# XHS_GEMINI_BASE_URL=https://api.ikuncode.cc/v1beta/models
# XHS_GEMINI_MODEL=gemini-3-pro-preview
# Some proxies require a different key format than Google.
# If your proxy key differs from GOOGLE_API_KEY, set it here:
# XHS_GEMINI_API_KEY=
# Auth mode for proxy (auto|query|header|bearer)
# XHS_GEMINI_AUTH_MODE=auto
# Timeouts/retries (optional)
# XHS_GEMINI_TIMEOUT_S=90
# XHS_GEMINI_RETRIES=1

# Optional: fallback model (MiniMax)
MINIMAX_API_KEY=
# Official: https://platform.minimaxi.com/docs/api-reference/text-chat
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1/text/chatcompletion_v2
# XHS_MINIMAX_TIMEOUT_S=90
# XHS_MINIMAX_RETRIES=1

# Stage 2: retrieval quality & cache (optional)
# XHS_MAX_QUERIES=6
# XHS_MAX_SOURCES=10
# XHS_TRUSTED_DOMAINS=zhihu.com,csdn.net,36kr.com,ebrun.com
# XHS_TAVILY_CACHE_DB=outputs/tavily_cache.sqlite
# XHS_TAVILY_CACHE_TTL_S=86400
# XHS_ENABLE_TOOL_LOOP=0

# Temperatures per module (optional)
# XHS_ANALYSIS_TEMPERATURE=0.0
# XHS_REWRITE_TEMPERATURE=0.7
# XHS_COVER_TEMPERATURE=0.6

# Stage 3.2: cover image generation (optional)
# XHS_COVER_IMAGE_PROVIDER=minimax
# XHS_COVER_IMAGE_MODEL=image-01
# XHS_COVER_IMAGE_ASPECT=3:4
#
# MiniMax image endpoint (optional override)
# XHS_MINIMAX_IMAGE_BASE_URL=https://api.minimaxi.com/v1/image_generation
